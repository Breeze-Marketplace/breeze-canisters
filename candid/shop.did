type WithdrawalAddress = 
 record {
   addedAt: int;
   name: text;
   owner: principal;
   subaccount: opt blob;
 };
type WithdrawError = 
 variant {
   Busy;
   InsufficientFunds: record {
                        balance: nat;
                        fee: nat;
                      };
   InvalidAmount: text;
   InvalidDestination: text;
   TransferError: text;
   Unauthorized: text;
   UnsupportedToken: text;
 };
type VariantInput = 
 record {
   attributes: opt vec ProductAttribute;
   imageUrls: vec text;
   name: text;
   price: PriceContext;
   pricing: opt Pricing;
   sku: SKU;
   status: ProductStatus;
 };
type VariantId = nat32;
type Value = 
 variant {
   "bool": bool;
   "int": int;
   "nat": nat;
   "principal": principal;
   "text": text;
 };
type ValidationError = 
 variant {
   ColumnsTooWide: record {
                     id: nat;
                     total: nat;
                   };
   DuplicateId: nat;
   EmptyText: record {
                field: text;
                id: nat;
              };
   InvalidImage: record {
                   id: nat;
                   reason: text;
                 };
   InvalidLink: record {
                  id: nat;
                  reason: text;
                };
   LayoutTooLarge: record {
                     bytes: nat;
                     max: nat;
                   };
   OutOfRange: record {
                 field: text;
                 id: nat;
                 max: nat;
                 min: nat;
               };
   TextTooLong: record {
                  field: text;
                  id: nat;
                  max: nat;
                };
   TooManyElements: record {max: nat;};
   TooManyItems: record {
                   field: text;
                   id: nat;
                   max: nat;
                 };
   TooManySections: record {max: nat;};
 };
type UpdateThemeError = 
 variant {
   ContrastTooLow: vec ContrastFailure;
   Unauthorized: text;
 };
type UpdateProductInput = 
 record {
   category: opt text;
   description: text;
   id: ProductId;
   productType: ProductType;
   tags: opt vec text;
   title: text;
   variants: vec VariantInput;
 };
type UpdateInventoryRequest = 
 record {
   lowStockThreshold: opt nat32;
   reservedDelta: int32;
   stockDelta: int32;
   variantId: VariantId;
 };
type TransformArgs = 
 record {
   context: blob;
   response: HttpRequestResult;
 };
type TranferFundsToMainError = 
 variant {
   InsufficientFunds: record {
                        balance: nat;
                        fee: nat;
                        token: text;
                      };
   InvalidStatus: text;
   NotFoundError: text;
   TransferError: record {
                    msg: text;
                    token: text;
                  };
   Unauthorized: text;
 };
type TrackInput = 
 record {
   artists: vec text;
   credits: vec Credit;
   durationMs: nat32;
   explicit: bool;
   files: vec AudioFile;
   isrc: opt text;
   lyrics: opt text;
   previewKey: opt text;
   title: text;
 };
type TrackId = nat32;
type TrackCount = 
 variant {
   all;
   first: nat;
   none;
 };
type Track = 
 record {
   artists: vec text;
   credits: vec Credit;
   durationMs: nat32;
   explicit: bool;
   files: vec AudioFile;
   id: TrackId;
   isrc: opt text;
   lyrics: opt text;
   previewKey: opt text;
   status: MusicStatus;
   title: text;
 };
type Totals = 
 record {
   discounts: Money;
   shipping: Money;
   subtotal: Money;
   tax: Money;
   total: Money;
 };
type TopUpTrigger = 
 variant {
   manual: principal;
   timer;
 };
type TopUpSkipReason = 
 variant {
   capReached;
   insufficientFunds: record {
                        balance: nat;
                        needed: nat;
                      };
   notifyPending;
 };
type TopUpSettings = 
 record {
   maxE8sPer30Days: nat;
   thresholdCycles: nat;
   topUpE8s: nat;
 };
type TopUpRun = 
 record {
   checks: vec TopUpCheck;
   finishedAt: int;
   resolved: nat;
   startedAt: int;
   trigger: TopUpTrigger;
 };
type TopUpOutcome = 
 variant {
   failed: text;
   minted: nat;
   notifying;
   refunded: text;
 };
type TopUpLimits = 
 record {
   maxE8sPer30Days: nat;
   maxThresholdCycles: nat;
   maxTopUpE8s: nat;
   minThresholdCycles: nat;
   minTopUpE8s: nat;
 };
type TopUpCheckStatus = 
 variant {
   balanceUnavailable: text;
   healthy;
   skipped: TopUpSkipReason;
   toppedUp: record {
               e8s: nat;
               outcome: TopUpOutcome;
             };
   transferFailed: text;
 };
type TopUpCheck = 
 record {
   balance: opt nat;
   canisterId: principal;
   kind: CanisterKind;
   status: TopUpCheckStatus;
 };
type TopUp = 
 record {
   at: int;
   balanceBefore: nat;
   blockIndex: nat;
   canisterId: principal;
   e8s: nat;
   id: nat;
   kind: CanisterKind;
   notifyAttempts: nat;
   outcome: TopUpOutcome;
   trigger: TopUpTrigger;
 };
type TopProduct = 
 record {
   productId: nat32;
   title: text;
   unitsSold: nat32;
 };
type Token = text;
type Time = int;
type ThemeColor = 
 record {
   blue: nat8;
   green: nat8;
   red: nat8;
 };
type TextTone = 
 variant {
   dark;
   light;
 };
type TextSpan = 
 record {
   bold: bool;
   italic: bool;
   link: opt Link;
   "text": text;
 };
type TextSource = 
 variant {
   literal: text;
   shopDescription;
   shopName;
 };
type Subscribers = 
 record {
   orderUpdated: vec principal;
   productDeleted: vec principal;
   productUpdated: vec principal;
   shopDetailsUpdated: vec principal;
 };
type StripeKeyStatus = 
 record {
   keyHint: text;
   mode: Mode;
 };
type StorefrontTheme = 
 record {
   accent: ThemeColor;
   buttonStyle: variant {
                  outline;
                  solid;
                };
   colorScheme: variant {
                  dark;
                  light;
                };
   density: variant {
              airy;
              compact;
              regular;
            };
   fonts: variant {
            archivoGrotesk;
            grotesk;
            mono;
            monoGrotesk;
          };
   onAccent: TextTone;
   onPrimary: TextTone;
   primary: ThemeColor;
   shape: variant {
            rounded;
            sharp;
            soft;
          };
 };
type StockAlert = 
 record {
   available: nat32;
   lowStockThreshold: nat32;
   product: record {
              id: nat32;
              title: text;
            };
   status: variant {
             LowStock;
             OutOfStock;
           };
   stock: nat32;
   "variant": record {
                id: nat32;
                name: text;
                sku: text;
              };
 };
type ShopUpdatedEventData = 
 record {
   bannerImageUrl: opt text;
   description: text;
   locationPublic: bool;
   logoUrl: text;
   name: text;
   physicalLocation: opt ShopLocation;
   presentation: opt Presentation;
 };
type ShopTheme = 
 record {
   accent: ThemeColor;
   colorScheme: variant {
                  dark;
                  light;
                };
   fonts: variant {
            archivoGrotesk;
            grotesk;
            mono;
            monoGrotesk;
          };
   hero: variant {
           banner;
           minimal;
           split;
         };
   onAccent: TextTone;
   onPrimary: TextTone;
   primary: ThemeColor;
   shape: variant {
            rounded;
            sharp;
            soft;
          };
 };
type ShopLocation = 
 variant {
   FullAddress: Address;
   PostalCode: text;
 };
type ShopDetailsUpdatedEventListener = func (event:
                                        ShopDetailsUpdatedEvent) -> ();
type ShopDetailsUpdatedEvent = record {data: ShopUpdatedEventData;};
type Shop = 
 service {
   /// Whether buyers can pay by card (in USD, through Stripe Checkout). Anyone may ask.
   acceptsCardPayments: () -> (bool) query;
   /// Archives the product and every variant (`#Archived`) and notifies product-deleted listeners. Owner or Admin.
   archiveProduct: (id: ProductId) -> (Result_6);
   /// Needs `Team.AssignRoles` and every permission in the role.
   assignRole: ("principal": principal, id: RoleId) -> (Result_4);
   /// Cancels `orderId` when still unpaid (`#created` or `#awaitingPayment`); rejects terminal or paid states.
   /// Only the order's buyer, or someone with `Orders.Cancel`, may cancel it.
   cancelOrder: (orderId: OrderId) -> (Result_58);
   /// Reads the order's payment ledger (ICP or ckUSDC) once for its invoice account; if the balance
   /// covers the total, marks the order paid (BRE-20). Only the order's buyer, an Owner or an Admin may
   /// call it; anyone else is rejected before any ledger call. Each order's account is read at most once
   /// every few seconds (`PaymentCheck.COOLDOWN_NANOS`); a check inside that window reports the last
   /// read's balance without calling the ledger (BRE-70). The payment watcher marks funded orders paid
   /// on its own timer, so this only makes that happen sooner.
   /// A full payment is honored until the order is cancelled, even after `expiresAt`. An unpaid order past
   /// `expiresAt` is expired on the spot. Paid orders return `#ok` again; cancelled orders are rejected.
   checkPayment: (orderId: OrderId) -> (Result_56);
   /// Same as `checkPayment`, kept for callers built before ckUSDC orders: it checks an order paid in
   /// either token.
   checkPaymentICP: (orderId: OrderId) -> (Result_56);
   /// Builds an order for `caller` from line items and `paymentCurrency`, resolving unit prices (USD→ICP via XRC,
   /// USD→USDC one to one, when the catalog has no price in that currency). USDC orders are paid in ckUSDC and
   /// stored with its 6 decimals. Registers a per-order ledger subaccount when the order is stored. Rejects the
   /// anonymous principal. `shippingAddress` is required, and checked, only when a line item is a `#Physical`
   /// product (any country, as an ISO 3166-1 alpha-2 code); a digital or service order stores no address (BRE-23).
   /// Rejects a buyer who already holds `OrderAccess.MAX_UNPAID_ORDERS_PER_BUYER` orders awaiting payment (BRE-111).
   createOrder: (input:
    record {
      items:
       vec
        record {
          productId: ProductId;
          quantity: nat32;
          title: text;
          variantId: VariantId;
        };
      paymentCurrency: Currency;
      shippingAddress: opt ShippingAddress;
    }) -> (Result_55);
   /// Creates a product from `input`, assigns IDs and inventory rows, and rejects an SKU listed twice or already used. Owner or Admin.
   /// If any variant is `#Active`, the product becomes `#Active` and subscribers are notified.
   createProduct: (input: CreateProductInput) -> (Result_6);
   /// Adds a release listing existing tracks in order. It may start with none while the artist
   /// uploads them: it's listed, and can be sold, once it has one. Needs `Music.Edit` and a signed-in
   /// caller.
   createRelease: (input: ReleaseInput) -> (Result_5);
   /// Needs `Team.EditRoles` and every permission in the role.
   createRole: (name: text, permissions: vec PermissionId) -> (Result_53);
   /// The buyer of card order `orderId` gets a Stripe Checkout page to pay it on. The first call
   /// creates the session (expiring in about 31 minutes, when the order expires too) and records it
   /// on the order; later calls return the same page. `successUrl` and `cancelUrl` are where Stripe
   /// sends the buyer afterwards: `https://`, or `http://` to localhost for development. Stripe
   /// replaces `{CHECKOUT_SESSION_ID}` in them. Payment is confirmed by `checkPayment`, or by the
   /// expiry sweep when the session ends.
   createStripeCheckout: (orderId: OrderId, successUrl: text, cancelUrl:
    text) -> (Result_52);
   /// Adds a track. Needs `Music.Edit` and a signed-in caller. Every track needs an MP3 file
   /// (`#mp3_320`); files are private vault keys, the preview a public one.
   createTrack: (input: TrackInput) -> (Result_1);
   /// Permanently removes the product, variants, and inventory; order history keeps line snapshots.
   /// Refuses a product with a variant a buyer gets a release through, paid or awaiting payment: archive it instead (BRE-192).
   deleteProduct: (id: ProductId) -> (Result_12);
   /// Deletes a release that never sold (`#ReleaseSold`: archive it instead) and no variant sells
   /// (`#InUse`). Needs `Music.Edit` and a signed-in caller.
   deleteRelease: (id: ReleaseId) -> (Result_9);
   /// Deletes the role and takes it from its members. Needs `Team.EditRoles` and every permission in the role.
   deleteRole: (id: RoleId) -> (Result_4);
   /// Deletes a track that no release lists (`#InUse` otherwise). Needs `Music.Edit` and a signed-in
   /// caller. Its vault files stay until deleted there.
   deleteTrack: (id: TrackId) -> (Result_9);
   /// Throws away unpublished changes: the draft goes back to the published layout. Needs
   /// `Storefront.Edit`, a signed-in caller and the current revision. Returns the new revision.
   discardStorefrontDraft: (expectedRevision: nat) -> (Result_50);
   /// Owner or Admin: low-stock alerts derived from inventory thresholds (one alert per qualifying
   /// inventory row). Other callers get `[]` (BRE-105). Superseded by `getDashboard`'s `stock`.
   getAlerts: () -> (vec Alert) query;
   /// `Funds.View`: the auto top-up settings, the 30-day spend and the last run. Null for anyone
   /// else.
   getAutoTopUp: () -> (opt AutoTopUpStatus) query;
   /// Returns distinct non-empty category strings assigned across products.
   getCategories: () -> (vec text) query;
   /// Returns this canister's cycle balance. No caller check: the balance is not private (anyone can
   /// read it from core's `getShopCycles`), and a fake 0 for outsiders would look like a drained shop.
   getCyclesBalance: () -> (nat) query;
   /// Owner or Admin: everything the admin dashboard shows, in one call (BRE-146). See
   /// `Dashboard.Dashboard` for each field. Reads every order, like `listOrders`.
   getDashboard: () -> (Result_49) query;
   /// Owner or Admin: the configured private media key for a variant, or `null` if the default path
   /// convention applies. Other callers always get `null` (BRE-105).
   getDigitalAssetKey: (productId: ProductId, variantId: VariantId) ->
    (opt text) query;
   /// Returns the cached XRC quote for `baseAsset`/`quoteAsset` when fresh. Otherwise spends cycles on a new XRC
   /// call and caches it. Open to any caller, anonymous included (storefront checkout): new calls come out of a
   /// per-minute budget shared by all pairs and callers, and return `#RateLimited` once it is spent.
   getExchangeRates: (baseAsset: Asset, quoteAsset: Asset) ->
    (FetchExchangeRateResponse);
   /// Owner or Admin: one row per inventory entry with variant/product labels, available qty, and stock
   /// status, a page at a time in variant ID order. Other callers get an empty page (BRE-105).
   getInventory: (after: opt VariantId, limit: opt nat) -> (Page_9) query;
   /// This canister's recent log entries, newest first (at most `limit`, capped at
   /// `Logger.MAX_LOGS`). Whether they survive an upgrade depends on the canister: shop keeps its
   /// log in stable state, core's is transient and an upgrade clears it. Authorized callers only.
   getLogs: (limit: opt nat) -> (Result_48) query;
   /// Returns the configured media canister principal, if set, to any signed-in caller. It isn't secret:
   /// buyers build `requestDigitalDelivery`'s download link from it and public assets are served from it.
   /// Private files stay behind the HMAC ticket the vault checks. Core reads it for `linkShopVault`.
   getMediaCanisterId: () -> (opt principal) query;
   /// The events the caller is subscribed to, so core can tell when it has lost a subscription and
   /// subscribe again (BRE-195). No permission check: it shows only the caller's own subscriptions.
   getMyEventSubscriptions: () -> (vec EventKind) query;
   /// Order `orderId` for its buyer, `Orders.View`, controllers (core, for the shops it hosts) or
   /// Marketplace. Core reads the orders it missed `OrderUpdated` notifications for, after finding
   /// them in `listOrderEvents` (BRE-203), so the same callers may read both.
   getMyOrder: (orderId: OrderId) -> (Result_47) query;
   /// The caller's own roles and effective permissions. Needs no permission: it shows only the caller's own.
   getMyPermissions: () -> (MyPermissions) query;
   /// Order `orderId`'s history, oldest first (BRE-133), for its buyer or an Owner or Admin. Events
   /// name who acted only by role (`#buyer`, `#merchant`, `#automatic`), never by principal.
   getOrderHistory: (orderId: OrderId) -> (Result_46) query;
   /// ICRC-1 account (`owner` + `subaccount`) for paying order `orderId`, and the ledger token it is
   /// paid in ("ICP" or "ckUSDC"), for use with that ledger's `icrc1_transfer` (BRE-20). Errors if the
   /// order is missing or its currency has no ledger. The account is the same on both ledgers.
   getOrderPaymentAccount: (orderId: OrderId) -> (Result_45) query;
   /// ICRC-1 account (`owner` + `subaccount`) for paying order `orderId` in ICP, for use with `icrc1_transfer`;
   /// errors if the order is missing or not ICP. Same destination as `getOrderPaymentAddressICP`.
   getOrderPaymentAccountICP: (orderId: OrderId) -> (Result_44) query;
   /// Hex-encoded ledger account identifier for paying order `orderId` in ICP; errors if the order is missing or not ICP.
   /// Only the ICP ledger takes these legacy account IDs; use `getOrderPaymentAccount` for ckUSDC.
   getOrderPaymentAddressICP: (orderId: OrderId) -> (Result_43) query;
   /// The permissions roles can be made of, with what each includes. Public: it's the same for every caller.
   getPermissionCatalog: () -> (vec PermissionDef) query;
   /// Returns the product `id` with per-variant stock and stock status, or `null` if missing.
   getProduct: (id: ProductId) -> (opt ProductWithInventory) query;
   getProductAttributeConfig: (productId: ProductId) ->
    (opt ProductAttributeConfig) query;
   /// Product records (catalog view without merged inventory fields), each variant with the release it
   /// sells, a page at a time in ID order (see `lib/Pagination`: pass `next` back as `after`).
   getProducts: (after: opt ProductId, limit: opt nat) -> (Page_8) query;
   /// Release `id` with its tracks, archived or not, or null. No caller check: past buyers see what
   /// they bought, and it holds no private file keys.
   getPublicRelease: (id: ReleaseId) -> (opt PublicRelease) query;
   /// The marketplaces the Owner recognized. Public: a shop's marketplaces are no secret.
   getRecognizedMarketplaces: () -> (vec RecognizedMarketplace) query;
   /// Storefront-facing name, description, media URLs, and location visibility filtered by caller role.
   getShopDetails: () ->
    (record {
       bannerImageUrl: opt text;
       description: text;
       logoUrl: opt text;
       name: text;
       physicalLocation: opt ShopLocation;
       showPhysicalLocation: bool;
     }) query;
   /// The presentation, artist preset and artist profile, each optional so an older client gets null
   /// for a value it can't decode. No caller check: it's how the public shop page looks.
   getShopPresentation: () -> (PresentationView) query;
   /// The storefront theme, or null when the shop hasn't set one. No caller check: the theme is how
   /// the public storefront looks, so anyone may read it.
   getShopTheme: () -> (opt ShopTheme) query;
   /// Owner or Admin: aggregate counts of products, active listings, low-stock SKUs, and open
   /// orders (paid, not yet fulfilled). Other callers get all zeros (BRE-105). Superseded by
   /// `getDashboard`; kept for frontends talking to shops not yet upgraded.
   getStats: () ->
    (record {
       activeListings: nat32;
       lowStockItems: nat32;
       openOrders: nat32;
       totalProducts: nat32;
     }) query;
   /// The published home page layout, or null when the shop hasn't published one (the storefront then
   /// shows its default layout). No caller check: it's what the public storefront shows, and holds only
   /// design content. Sections and elements are optional so a client that can't decode a newer one
   /// skips it.
   getStorefront: () -> (opt PublishedLayoutView) query;
   /// The draft layout and its revision, for the editor. Needs `Storefront.Edit`, so unpublished pages
   /// stay private.
   getStorefrontEditor: () -> (Result_42) query;
   /// Owner or Admin: the mode and last four characters of the Stripe key, or null when none is
   /// set. Null for everyone else.
   getStripeKeyStatus: () -> (opt StripeKeyStatus) query;
   /// The lyrics of track `id`, if a release lists it. No caller check: listed tracks are public.
   getTrackLyrics: (id: TrackId) -> (opt text) query;
   /// Owner or Admin: the main account's balance and the ledger fee for each token, as `withdrawFunds`
   /// sees them. An update call, since it reads both ledgers; refused callers get no ledger calls.
   getWithdrawableBalances: () -> (Result_41);
   /// Lets `principal` (core) subscribe to the shop's events and see a private location. Owner only.
   grantMarketplaceAccess: ("principal": principal) -> (Result_3);
   /// Whether release `id` has sold, so it can't lose a track or be deleted. Needs `Music.Edit`.
   isReleaseSold: (id: ReleaseId) -> (Result_39) query;
   /// `Funds.View`: top-ups that moved ICP, newest first, before id `after`. Empty for anyone else.
   listAutoTopUps: (after: opt nat, limit: opt nat) -> (Page_7) query;
   /// Lists each event's subscribers. Owner or Admin.
   listEventSubscribers: () -> (Result_38) query;
   /// Members (principals with at least one role) in principal order. Needs `Team.View`.
   listMembers: (after: opt principal, limit: opt nat) -> (Result_37) query;
   /// Orders placed by `caller`, newest first, a page at a time. Empty for the anonymous principal.
   listMyOrders: (after: opt OrderId, limit: opt nat) -> (Page_4) query;
   /// Every order's history across the shop, oldest first, after sequence number `after` (see
   /// `lib/Pagination`). A subscriber that missed `OrderUpdated` notifications pages from the last
   /// `seq` it applied. Controllers (core, for the shops it hosts), Marketplace and `Orders.View`
   /// only: events reveal what was ordered when. Other callers get an empty page.
   listOrderEvents: (after: opt nat, limit: opt nat) -> (Page_5) query;
   /// Owner or Admin: every stored order, newest first, a page at a time (see `lib/Pagination`:
   /// pass `next` back as `after`). Other callers get an empty page.
   listOrders: (after: opt OrderId, limit: opt nat) -> (Page_4) query;
   /// A page of active releases that have a track, without their tracks (`getPublicRelease` has
   /// them), in ID order. No caller check: it's the storefront's catalog, and holds no private file
   /// keys.
   listPublicReleases: (after: opt ReleaseId, limit: opt nat) ->
    (Page_3) query;
   /// A page of every release, archived ones included, for the editor. Needs `Music.Edit`.
   listReleases: (after: opt ReleaseId, limit: opt nat) -> (Result_36) query;
   /// Roles in ID order. Needs `Team.View`.
   listRoles: (after: opt RoleId, limit: opt nat) -> (Result_35) query;
   /// A page of every track, with private file keys and lyrics, for the editor: at most
   /// `Music.Limits.MAX_TRACKS_PAGE` tracks. Needs `Music.Edit`.
   listTracks: (after: opt TrackId, limit: opt nat) -> (Result_34) query;
   /// Owner or Admin: main canister ledger account plus tracked subaccounts with live `icrc1_balance_of` balances.
   listWalletAccounts: () -> (vec Account) query;
   /// `Funds.View`: the saved withdrawal addresses, oldest first. Empty for anyone else, since
   /// they're the merchant's own accounts.
   listWithdrawalAddresses: () -> (vec WithdrawalAddress) query;
   /// Marks order `orderId` fulfilled: every line not yet delivered is recorded as sent by `method`
   /// (`#inPerson` when null), then the order becomes `#fulfilled`. Allowed from `#paid`, or from
   /// `#partiallyFulfilled` (some digital lines already downloaded). Needs `Orders.Fulfill`.
   markOrderFulfilled: (orderId: OrderId, method: opt DeliveryMethod) ->
    (Result_33);
   /// Publishes the draft: buyers see it from now on. Needs `Storefront.Edit`, a signed-in caller and the
   /// current revision.
   publishStorefront: (expectedRevision: nat) -> (Result_32);
   /// Returns funds sent to a cancelled order's payment account (a late or partial payment), minus the
   /// ledger fee, on every supported ledger. The buyer may name the destination account (default: the
   /// buyer's own account). An Owner or Admin may trigger it, but the funds always go to the buyer.
   reclaimOrderPayment: (orderId: OrderId, to: opt RefundDestination) ->
    (Result_31);
   /// Recognizes the marketplace whose core (backend) canister is `backendCanisterId`: asks it for
   /// its frontend canister and name, records them, and grants it Marketplace access. Owner only.
   /// Recognizing it again refreshes the details.
   recognizeMarketplace: (backendCanisterId: principal) -> (Result_30);
   /// Removes `principal`'s subscription to `event`; returns whether it had one. Owner or Admin.
   removeEventSubscriber: (event: EventKind, "principal": principal) ->
    (Result_29);
   /// Owner only. Forgets the Stripe key and turns card payments off. Orders already sent to
   /// Stripe Checkout can't be confirmed afterwards, and expire unpaid.
   removeStripeKey: () -> (Result_3);
   /// Removes an account from the tracked set. Allowed only when the account balance is 0 and caller is the shop owner.
   removeWalletAccount: (accountId: text) -> (Result_27);
   /// Owner only: removes `to` from the saved withdrawal addresses.
   removeWithdrawalAddress: (to: Destination) -> (Result_26);
   /// Mints a short-lived HMAC delivery ticket for a paid digital line item. Caller must be the order buyer.
   /// The first ticket for a line records it as delivered, which can fulfil the order (BRE-133).
   /// The download link is `<vault URL><mediaKey>?token=<token>`, built by the client: the shop
   /// doesn't know which network's gateway serves its vault (BRE-140).
   requestDigitalDelivery: (orderId: OrderId, lineIndex: nat, ttlSeconds:
    opt nat) -> (Result_25);
   /// Tickets for every file of the release order line `lineIndex` sells, in `format`, in track
   /// order (BRE-185). Only the order's buyer, once it is paid. The files are read from the release
   /// as it is now, so tracks added and files replaced since the sale are included; a track with no
   /// file in `format` is left out (`#FormatUnavailable` when none has one). Each link is
   /// `<vault URL><mediaKey>?token=<token>`, built by the client, and works until `expiresAt`. The
   /// first call for a line records it as delivered, as `requestDigitalDelivery` does. Signing is
   /// bounded by the release's track cap (`ReleaseDelivery.MAX_FILES`) and costs one `raw_rand`.
   requestReleaseDelivery: (orderId: OrderId, lineIndex: nat, format:
    AudioFormat, ttlSeconds: opt nat) -> (Result_24);
   /// Takes Marketplace access from `principal`, and forgets it as a recognized marketplace. Owner only.
   revokeMarketplaceAccess: ("principal": principal) -> (Result_3);
   /// Replaces the HMAC secret that signs delivery tickets with a fresh random one and pushes it to
   /// the media canister. Outstanding tickets stop working. Owner only.
   rotateHmacSecretKey: () -> (Result_22);
   /// Owner only: runs auto top-up now instead of waiting for the hourly check. With auto top-up
   /// off it only asks the CMC about top-ups still waiting on it.
   runAutoTopUp: () -> (Result_21);
   /// Saves the draft layout and returns the new revision. Needs `Storefront.Edit`, a signed-in caller
   /// and the revision the editor last saw (`#RevisionConflict` otherwise). Every limit is checked and
   /// the theme must pass WCAG AA before anything is stored.
   saveStorefrontDraft: (layout: LayoutInput, expectedRevision: nat) ->
    (Result_20);
   /// Owner only: saves `to` with `name`, or renames it if it's already saved. At most
   /// `WithdrawalAddresses.MAX_ADDRESSES`, each name at most `MAX_NAME_CHARS` characters.
   /// `withdrawFunds` doesn't require a saved address.
   saveWithdrawalAddress: (to: Destination, name: text) -> (Result_19);
   /// Replaces the artist profile, or with null removes it. Needs `Storefront.Edit` and a signed-in
   /// caller. Every length and count is checked before anything is stored (`#Invalid` lists each
   /// problem).
   setArtistProfile: (artistProfile: opt ArtistProfile) -> (Result_18);
   /// Owner only: turns auto top-up on with `settings`, or off with null. When on, the shop
   /// converts ICP from its main account into cycles for itself or its vault whenever either is
   /// under `thresholdCycles`, `topUpE8s` at a time, at most `maxE8sPer30Days` in any 30 days.
   setAutoTopUp: (settings: opt TopUpSettings) -> (Result_17);
   /// Stores the private media object key for a digital product variant. Owner or Admin.
   setDigitalAssetKey: (productId: ProductId, variantId: VariantId, mediaKey:
    text) -> (Result_15);
   /// Sets the HMAC secret used to mint delivery tickets, and a version number recorded with it;
   /// propagates the key to the media canister when configured. Owner only. Prefer
   /// `rotateHmacSecretKey`, which draws the key from `raw_rand`.
   setHmacSecretKey: (version: nat8, key: blob) -> (Result_15);
   /// Sets the media canister (asset) canister principal used for shop uploads and URLs. Owner only.
   setMediaCanisterId: (canisterId: principal) -> (Result_3);
   /// Hands shop ownership to `principal`; the caller stops being Owner. Only the Owner may call.
   setOwner: ("principal": principal) -> (Result_3);
   setProductAttributeConfig: (productId: ProductId, config:
    ProductAttributeConfig) -> (Result_12);
   /// Archives (`#Archived`) or restores (`#Active`) a release. Archived releases leave the public list
   /// but past buyers keep them. Needs `Music.Edit` and a signed-in caller.
   setReleaseStatus: (id: ReleaseId, status: MusicStatus) -> (Result_5);
   /// Shows the shop as a storefront or an artist page, and sets the artist preset unless it's null.
   /// Needs `Storefront.Edit` and a signed-in caller. Tells subscribers (core) when the presentation
   /// changed, with a `ShopDetailsUpdated` event.
   setShopPresentation: (mode: Presentation, artistPreset:
    opt ArtistPreset) -> (Result_11);
   /// Owner only. Checks `key` is a restricted key (`rk_…`) that can read Checkout Sessions, by
   /// listing one session, then stores it, replacing any earlier key. Secret keys are refused:
   /// shop state is readable by node operators, so the key is restricted to limit what a leak
   /// could do. Give the restricted key write access to Checkout Sessions and nothing else.
   setStripeKey: (key: text) -> (Result_10);
   /// Archives (`#Archived`) or restores (`#Active`) a track. Needs `Music.Edit` and a signed-in caller.
   setTrackStatus: (id: TrackId, status: MusicStatus) -> (Result_1);
   /// Sets the release variant `variantId` sells, or with null goes back to its single media key.
   /// The release must exist, be active and have a track. A variant that has sold can't move off its release
   /// (`#ReleaseSold`): its buyers would lose it. Linking a sold variant marks the release sold. Needs
   /// `Music.Edit` and a signed-in caller.
   setVariantDeliverable: (variantId: VariantId, deliverable:
    opt Deliverable) -> (Result_9);
   /// The element types (and their settings versions, with `"section"`'s) this shop accepts. The
   /// editor offers only these. No caller check: it describes the wasm, not the shop's data.
   storefrontElementTypes: () -> (vec ElementType) query;
   /// The outcall transform for Stripe replies (`Stripe.transform`): pure, so anyone may call it.
   stripeTransform: (args: TransformArgs) -> (HttpRequestResult) query;
   /// Registers `caller` as a subscriber for order create/update events, which carry the buyer
   /// and the order contents.
   subscribeToOrderUpdated: (listener: OrderUpdatedEventListener) -> ();
   /// Registers `caller` as a subscriber for product delete/archive notifications.
   subscribeToProductDeleted: (listener: ProductDeletedEventListener) -> ();
   /// Registers `caller` as a subscriber for active product create/update events.
   subscribeToProductUpdated: (listener: ProductUpdatedEventListener) -> ();
   /// Registers `caller` as a subscriber for shop metadata and location change events.
   subscribeToShopDetailsUpdated: (listener:
    ShopDetailsUpdatedEventListener) -> ();
   /// Transfers all funds from the account identified by accountId to the store's main account. Callable only by the shop owner.
   /// An order's payment subaccount can be swept only once the order is paid: before that the funds are the
   /// buyer's payment in progress, and after a cancellation they are the buyer's to reclaim (`#InvalidStatus`).
   transferFundsToMain: (accountId: text) -> (Result_8);
   /// Needs `Team.AssignRoles` and every permission in the role.
   unassignRole: ("principal": principal, id: RoleId) -> (Result_4);
   /// Removes the caller's own subscription, so it needs no role.
   unsubscribeFromOrderUpdated: () -> ();
   /// Removes the caller's own subscription, so it needs no role.
   unsubscribeFromProductDeleted: () -> ();
   /// Removes the caller's own subscription, so it needs no role.
   unsubscribeFromProductUpdated: () -> ();
   /// Removes the caller's own subscription, so it needs no role.
   unsubscribeFromShopDetailsUpdated: () -> ();
   /// Applies `stockDelta` and `reservedDelta` to `input.variantId`, optionally updates low-stock threshold. Owner or Admin.
   updateInventory: (input: UpdateInventoryRequest) -> (Result_7);
   /// Updates product `input.id` and its variants, matched by SKU: new SKUs create new variant IDs and inventory,
   /// and variants left out are removed. Rejects an SKU listed twice or used by another product, and
   /// leaving out (or renaming the SKU of) a variant a buyer gets a release through, paid or awaiting payment: archive it
   /// instead (BRE-192). Owner or Admin.
   /// Active products trigger a product-updated notification.
   updateProduct: (input: UpdateProductInput) -> (Result_6);
   /// Replaces a release's details and track list. Once it has sold, every track must stay
   /// (`#ReleaseSold`); reordering and adding are fine. A release a variant sells keeps at least one
   /// track (`#InUse`). Needs `Music.Edit` and a signed-in caller.
   updateRelease: (id: ReleaseId, input: ReleaseInput) -> (Result_5);
   /// Needs `Team.EditRoles` and every permission in the role before and after.
   updateRole: (id: RoleId, name: text, permissions: vec PermissionId) ->
    (Result_4);
   /// Patches shop metadata, optional physical location, and public location flag; notifies shop-details subscribers. Owner or Admin.
   updateShopDetails: (input:
    record {
      bannerImageUrl: opt text;
      description: opt text;
      logoUrl: opt text;
      name: opt text;
      physicalLocation:
       opt variant {
             FullAddress: opt Address;
             PostalCode: text;
           };
      showPhysicalLocation: opt bool;
    }) -> (Result_3);
   /// Sets the storefront theme, or with null goes back to the marketplace's look. Needs
   /// `Storefront.Edit` and a signed-in caller. Rejects (`#ContrastTooLow`, naming each pairing) a theme
   /// whose colors don't meet WCAG AA everywhere the storefront and checkout use them.
   updateShopTheme: (theme: opt ShopTheme) -> (Result_2);
   /// Replaces a track's details and files; buyers of releases listing it get the new files. Needs
   /// `Music.Edit` and a signed-in caller.
   updateTrack: (id: TrackId, input: TrackInput) -> (Result_1);
   /// Owner only: sends `token` ("ICP" or "ckUSDC") from the shop's main account to `to`, an ICRC-1
   /// account outside this shop. `amount` is in the token's smallest unit; null sends everything the
   /// main account holds minus the ledger fee, read from the ledger at call time. The fee is paid on top.
   /// `createdAtTime` (nanoseconds since the epoch, default: now) is the transfer's `created_at_time`:
   /// a client that retries after a timeout passes the same value again, and if the first attempt went
   /// through, the ledger reports a duplicate and this returns that transfer's block index instead of
   /// sending twice (BRE-76, BRE-70). Returns the block index and the amount sent.
   withdrawFunds: (token: Token, to: Destination, amount: opt nat,
    createdAtTime: opt nat64) -> (Result);
 };
