              carrier: opt text;
              trackingNumber: opt text;
            };
 };
type Deliverable = variant {release: ReleaseId;};
type Dashboard = 
 record {
   generatedAt: int;
   orders:
    record {
      awaitingPayment: nat32;
      oldestToFulfillAt: opt int;
      toFulfill: nat32;
    };
   products:
    record {
      active: nat32;
      archived: nat32;
      draft: nat32;
      inactive: nat32;
      withoutImages: nat32;
    };
   recentOrders: vec OrderSummary;
   sales: record {
            last24h: Sales;
            last30d: Sales;
            last7d: Sales;
          };
   stock: record {
            alerts: vec StockAlert;
            lowStock: nat32;
            outOfStock: nat32;
          };
   topProducts: vec TopProduct;
 };
