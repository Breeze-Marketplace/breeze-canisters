 };
type Page = 
 record {
   items: vec Track;
   next: opt TrackId;
 };
type OrderUpdatedEventListener = func (event: OrderUpdatedEvent) -> ();
type OrderUpdatedEventData = 
 record {
   buyer: principal;
   createdAt: Time;
   items: vec LineItemSnapshot;
   logEvent: opt OrderLogEvent;
   orderId: OrderId;
   status: OrderStatus;
   totals: Totals;
 };
type OrderUpdatedEvent = record {data: OrderUpdatedEventData;};
type OrderSummary = 
 record {
   createdAt: int;
   id: nat32;
   itemCount: nat32;
   status: OrderStatus;
   total: Money__1;
 };
type OrderStatus = 
 variant {
   awaitingPayment;
   canceled;
   created;
   fulfilled;
   paid;
   partiallyFulfilled;
   processing;
   refunded;
 };
type OrderRefund = 
 record {
   amount: nat;
   blockIndex: nat;
   token: text;
 };
type OrderLogEvent = 
 record {
   at: int;
   seq: nat;
 };
type OrderId = nat32;
type OrderEventKind = 
 variant {
   awaitingPayment: record {provider: variant {
                                        ICRC1;
                                        Manual;
                                        Stripe;
                                      };};
   canceled: record {reason: opt CancelReason;};
   created;
   fulfilled: record {method: opt DeliveryMethod;};
   lineDelivered: record {
                    lineIndex: nat;
                    method: DeliveryMethod;
                  };
   paid: record {provider: variant {
                             ICRC1;
                             Manual;
                             Stripe;
                           };};
   partiallyFulfilled;
   refunded;
 };
type OrderEvent = 
 record {
   at: int;
   by: Initiator;
   kind: OrderEventKind;
   orderId: OrderId;
   seq: nat;
 };
type Order = 
 record {
   buyer: principal;
   canceledAt: opt Time;
   createdAt: Time;
   expiresAt: Time;
   fulfillment: opt Fulfillment;
   id: OrderId;
   items: vec LineItemSnapshot;
   notes: opt text;
   payment: opt PaymentRef;
   shippingAddress: opt ShippingAddress;
   status: OrderStatus;
   totals: Totals;
   updatedAt: Time;
 };
type MyPermissions = 
 record {
   isSuperuser: bool;
   permissions: vec PermissionId;
   roleIds: vec RoleId;
 };
type MusicStatus = 
 variant {
   Active;
   Archived;
 };
type MusicError = 
 variant {
   InUse: text;
   InvalidInput: text;
   LimitReached: text;
   NotFound: text;
   ReleaseSold: text;
   Unauthorized: text;
 };
type Money__1 = 
 record {
   amount: nat64;
   currency:
    record {
      class: variant {
               Cryptocurrency;
               FiatCurrency;
             };
      symbol: text;
    };
   metadata: record {decimals: nat32;};
 };
type Money = 
 record {
   amount: nat64;
   currency: Currency;
   metadata: record {decimals: nat32;};
 };
type Mode = 
 variant {
   live;
   test;
 };
type Member = 
 record {
   "principal": principal;
   roleIds: vec RoleId;
 };
type MarketplaceRelease = 
 record {
   artist: text;
   genre: opt text;
   kind: ReleaseKind;
 };
type LogLevel = 
 variant {
   Error;
   Info;
   Warning;
 };
type Log = 
 record {
   fields: vec Field;
   level: LogLevel;
   message: text;
   timestamp: Time;
 };
type Link = 
 variant {
   category: text;
   external: text;
   product: ProductId;
 };
type LineItemSnapshot = 
 record {
   listedPrices: vec Money;
   options: vec record {
                  text;
                  text;
                };
   productId: ProductId;
   quantity: nat32;
   sku: opt text;
   title: text;
   unitPrice: Money;
   variantId: VariantId;
 };
type LayoutInput = 
 record {
   home: vec Section;
   theme: opt StorefrontTheme;
 };
type InventoryItem = 
 record {
   available: nat32;
   lowStockThreshold: nat32;
   product: record {
              id: ProductId;
              title: text;
            };
   "reserved": nat32;
   status: variant {
             InStock;
             LowStock;
             OutOfStock;
           };
   stock: nat32;
   "variant": record {
                id: VariantId;
                name: text;
                sku: SKU;
              };
 };
type Initiator = 
 variant {
   automatic;
   buyer;
   merchant;
 };
type ImageSource = 
 variant {
   asset: AssetKey;
   shopBanner;
   shopLogo;
 };
type HttpRequestResult = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type HttpHeader = 
 record {
   name: text;
   value: text;
 };
type Fulfillment = 
 record {
   carrier: opt text;
   date: Time;
   trackingNumber: opt text;
 };
type Float = float64;
type Field = 
 record {
   text;
   Value;
 };
type FetchExchangeRateResponse = 
 variant {
   err: FetchError;
   ok: ExchangeRateCacheEntry;
 };
type FetchError = 
 variant {
   InsufficientCycles;
   XRCError: ExchangeRateError;
 };
type FeaturedReleaseChoice = 
 variant {
   latest;
   picked: ReleaseId;
 };
type ExchangeRateMetadata = 
 record {
   base_asset_num_queried_sources: nat64;
   base_asset_num_received_rates: nat64;
   decimals: nat32;
   forex_timestamp: opt nat64;
   quote_asset_num_queried_sources: nat64;
   quote_asset_num_received_rates: nat64;
   standard_deviation: nat64;
 };
type ExchangeRateError = 
 variant {
   AnonymousPrincipalNotAllowed;
   CryptoBaseAssetNotFound;
   CryptoQuoteAssetNotFound;
   FailedToAcceptCycles;
   ForexAssetsNotFound;
   ForexBaseAssetNotFound;
   ForexInvalidTimestamp;
   ForexQuoteAssetNotFound;
   InconsistentRatesReceived;
   NotEnoughCycles;
   Other: record {
            code: nat32;
            description: text;
          };
   Pending;
   RateLimited;
   StablecoinRateNotFound;
   StablecoinRateTooFewRates;
   StablecoinRateZeroRate;
 };
type ExchangeRateCacheEntry = 
 record {
   descaledRate: Float;
   lastUpdated: Time;
   xrcResponse: ExchangeRate;
 };
type ExchangeRate = 
 record {
   base_asset: Asset;
   metadata: ExchangeRateMetadata;
   quote_asset: Asset;
   rate: nat64;
   timestamp: nat64;
 };
type EventKind = 
 variant {
   OrderUpdated;
   ProductDeleted;
   ProductUpdated;
   ShopDetailsUpdated;
 };
type Error = 
 variant {
   InputError: text;
   NotFound: text;
   Unauthorized: text;
 };
type EntitlementError = 
 variant {
   InvalidInput: text;
   InvalidLineIndex: text;
   MediaNotConfigured: text;
   NotDigitalProduct: text;
   NotFound: text;
   OrderNotPaid: text;
   Unauthorized: text;
 };
type ElementType = 
 record {
   kind: text;
   version: nat;
 };
type ElementNode = 
 record {
   element: Element;
   id: nat;
 };
type Element = 
 variant {
   button:
    record {
      align: Align;
      link: Link;
      style: variant {
               primary;
               secondary;
             };
      "text": text;
    };
   divider;
   faq: record {entries: vec record {
                               answer: text;
                               question: text;
                             };};
   featuredRelease:
    record {
      release: FeaturedReleaseChoice;
      showBuy: bool;
      tracks: TrackCount;
    };
   heading:
    record {
      align: Align;
      level: variant {
               h1;
               h2;
               h3;
             };
      "text": TextSource;
    };
   image:
    record {
      alt: text;
      aspect: variant {
                banner;
                original;
                square;
                tall;
                wide;
              };
      link: opt Link;
      source: ImageSource;
    };
   products:
    record {
      limit: nat;
      perRow: nat;
      showCategoryFilter: bool;
      sort: ProductSort;
      source: ProductSource;
      title: opt text;
    };
   releases:
    record {
      limit: nat;
      perRow: nat;
      showArtist: bool;
      sort: ReleaseSort;
      source: ReleaseSource;
      style: ReleaseStyle;
      title: opt text;
    };
   shopInfo: record {
               showDescription: bool;
               showLocation: bool;
             };
   spacer: record {size: variant {
                           large;
                           medium;
                           small;
                         };};
   "text": record {
             align: Align;
             content: vec RichTextNode;
           };
 };
type EditorState = 
 record {
   draft: opt DraftView;
   hasUnpublishedChanges: bool;
   publishedAt: opt Time;
