   ShopSlugConflict;
   Unauthenticated;
 };
type Core = 
 service {
   addManagedShop: (shopCanisterId: principal) -> (AddManagedShopResponse);
   /// Lets every shop or vault upgrade to `version`, once its canary runs it, and makes it the
   /// version new shops or vaults get when it's newer than the current one. Check the canary works
   /// before approving. A yanked version is refused. Needs `Upgrades.Approve`.
   approveRollout: (name: WasmName, version: Version) -> (Result_52);
   /// Needs `Team.AssignRoles` and every permission in the role.
   assignRole: ("principal": principal, id: RoleId) -> (Result_2);
   /// Cancels a pending handover: core is again the only controller of the shop and its vault.
   /// The shop owner or the pending controller.
   cancelShopHandover: (shopId: principal) -> (Result_6);
   /// Whether `slug` is valid and free for a new shop of the caller's.
   checkShopSlug: (slug: text) -> (Result_51) query;
   /// Asks `shopIds`, or every registered shop when null, which events core still gets, one shop at
   /// a time. Where core lost one, subscribes again and resyncs the shop's products (BRE-195). Then
   /// catches up on the shop's orders from its order log (BRE-203). Core also runs this daily and
   /// five minutes after each install or upgrade. Needs `Shops.Manage`: each shop costs core a call,
   /// a resync a call per page of products, and a catch-up a call per page of events and per order
   /// it reads.
   checkShopSubscriptions: (shopIds: opt vec principal) -> (Result_50);
   /// Finishes a handover: called by the new controller itself, which proves the principal is in
   /// the merchant's hands. Core removes itself as a controller of the vault and the shop, and
   /// stops upgrading them. Retry after `#UpdateFailed`.
   confirmShopHandover: (shopId: principal) -> (Result_49);
   /// Needs `Team.EditRoles` and every permission in the role.
   createRole: (name: text, permissions: vec PermissionId) -> (Result_48);
   /// Creates the Shop canister for a paid quote (see `createShopQuote`) and registers it in the
   /// marketplace. If creation fails the quote stays paid: call again to retry, or refund it.
   createShop: (quoteId: QuoteId) -> (CreateShopResponse);
   /// Quotes a hosted shop: locks the price in `currency` for 30 minutes, reserves the shop name and
   /// URL slug (`req.slug`, or one made from the name), and returns the account to pay. Pay the quoted amount there, then call `createShop` with the quote ID.
   createShopQuote: (req: CreateShopQuoteRequest) -> (Result_47);
   /// Registers the caller as a user in the system. Required before creating or managing shops.
   /// A principal costs nothing to make, so new registrations come out of a budget shared by all
   /// callers and stop at a hard cap (`#RateLimited`, BRE-120); an existing user is never refused.
   createUser: () -> (Result_46);
   /// Deletes the caller's saved address `id`. Refuses anonymous callers.
   deleteMyAddress: (id: AddressId) -> (Result_11);
   /// Deletes the role and takes it from its members. Needs `Team.EditRoles` and every permission in the role.
   deleteRole: (id: RoleId) -> (Result_2);
   /// The caller's alert settings. Needs `Alerts.View`.
   getAlertSettings: () -> (Result_45) query;
   /// How many unmuted alerts the caller hasn't marked read (at most 100), and the newest alert's
   /// number to mark read with `markAlertsSeen`. Needs `Alerts.View`.
   getAlertSummary: () -> (Result_44) query;
   /// Cycle balances and freezing thresholds of core, product_index, canister_factory and the
   /// frontend, read with canister_status (scripts/setup.sh makes core a status viewer of each).
   /// Shops and vaults aren't listed. A canister core can't read shows an error row. Needs `Cycles.View`.
   getCanisterCycles: () -> (Result_42);
   /// The shop and vault versions new shops get: each is the newest approved rollout, unless it was
   /// yanked (BRE-85). Null: none, so shop creation fails until a version is approved. Needs `Upgrades.View`.
   getCurrentWasmVersions: () -> (Result_41) query;
   /// Core's cycle balance. A query, so it costs core nothing; the balance is public on the IC anyway.
   getCyclesBalance: () -> (nat) query;
   /// Returns the cached XRC quote for `baseAsset`/`quoteAsset` when fresh. Otherwise spends cycles on a new XRC
   /// call and caches it. Open to any caller, anonymous included (storefront checkout): new calls come out of a
   /// per-minute budget shared by all pairs and callers, and return `#RateLimited` once it is spent.
   getExchangeRates: (baseAsset: Asset, quoteAsset: Asset) ->
    (FetchExchangeRateResponse);
   /// This canister's recent log entries, newest first (at most `limit`, capped at
   /// `Logger.MAX_LOGS`). Whether they survive an upgrade depends on the canister: shop keeps its
   /// log in stable state, core's is transient and an upgrade clears it. Authorized callers only.
   getLogs: (limit: opt nat) -> (Result_40) query;
   /// Core's ICP (e8s) and ckUSDC (6 decimals) balances, totalled over its subaccounts: the main
   /// account and each shop creation quote's deposit account, except the deposits of settled
   /// quotes (claimed, refunded, or unpaid past their grace period) that an earlier call found
   /// empty (BRE-101). Core keeps no accounts for users (BRE-83). `accounts` lists the main
   /// account and every other account that holds funds. Needs `Balances.View`.
   getMarketplaceBalances: () -> (Result_39);
   /// Who this marketplace is, for a shop that recognizes it (`recognizeMarketplace` on the shop):
   /// core's ID, the frontend canister's ID (null when it isn't deployed) and the marketplace's
   /// name. Public: none of it is private.
   getMarketplaceInfo: () ->
    (record {
       backendCanisterId: principal;
       frontendCanisterId: opt principal;
       name: text;
     }) query;
   /// The caller's own roles and effective permissions. Needs no permission: it shows only the caller's own.
   getMyPermissions: () -> (MyPermissions) query;
   /// The permissions roles can be made of, with what each includes. Public: it's the same for every caller.
   getPermissionCatalog: () -> (vec PermissionDef) query;
   /// Whether the fees are on, and the cycles each event from a shop core doesn't host must carry.
   getShopCallFees: () -> (record {
                             enforced: bool;
                             eventCycles: nat;
                           }) query;
   /// Who controls a registered shop and its vault: core, core and a pending new controller, or
   /// the merchant's own principal. Public: a canister's controllers are public on the IC anyway.
   getShopControl: (shopId: principal) -> (Result_38) query;
   /// The current price of a hosted shop, in USD and in each accepted currency. Open to any caller
   /// with no limit of its own: the ICP price reads the fixed USD/ICP pair through the exchange-rate
   /// cache (BRE-63), so core makes at most one XRC call per 30 min, or one a minute while XRC
   /// fails, however often this is called (BRE-120).
   getShopCreationPrice: () -> (Result_37);
   /// The caller's quote with ID `quoteId`, including its status and where to pay it.
   getShopCreationQuote: (quoteId: QuoteId) -> (opt QuoteView) query;
   /// The shop's and vault's balances and time left as of core's last reading (at most a day
   /// old). Anyone may call it: a shop's cycle balance is already public through its own
   /// `getCyclesBalance`.
   getShopCycles: (shopId: principal) -> (Result_36) query;
   /// Events about shop `shopId` (and its vault) after sequence number `after`, oldest first, a page
   /// at a time. Needs `History.View`.
   getShopHistory: (shopId: principal, after: opt nat, limit: opt nat) ->
    (Result_29) query;
   /// The wasm of a published release, from the canister factory. Public; only published
   /// versions. A composite query, so the answer isn't certified: check its SHA-256 against
   /// `listShopReleases`.
   getShopRelease: (name: WasmName, version: Version) ->
    (Result_34) composite_query;
   /// The current slug of each registered shop in `ids` (at most 200), for building shop links from
   /// canister IDs (products, orders). Unregistered shops are left out.
   getShopSlugs: (ids: vec principal) -> (vec ShopSlug) query;
   /// Orders indexed for the authenticated caller across shops, newest first, a page at a time (see
   /// `lib/Pagination`: pass `next` back as `after`).
   getUserOrders: (after: opt UserOrderCursor, limit: opt nat) ->
    (GetUserOrdersResponse) query;
   /// Shops the caller manages (owns or was given access to), for the user dashboard, a page at a
   /// time in canister ID order.
   getUserShops: (after: opt principal, limit: opt nat) -> (Page_9) query;
   /// Core's own main-account ICP balance. Needs `Balances.View`.
   getWalletBalance: () -> (Result_33);
   /// Lets core manage a self-managed shop again, once the merchant has added core back as a
   /// controller of the shop and its vault. The shop owner or the self-managed controller.
   handBackShop: (shopId: principal) -> (Result_6);
   /// Whether `principal` holds platform `permission` (`PlatformPermissions`). product_index,
   /// trust_safety and cycles_dispenser call this to authorize moderators, policy editors and cycles
   /// viewers (BRE-27, BRE-48, BRE-152, BRE-177); any other caller gets `false`.
   hasPlatformPermission: ("principal": principal, permission:
    PermissionId) -> (bool);
   /// Asks a registered shop for its vault and records it, for shops whose vault core didn't record
   /// (created before it did, or added with `registerShop`). Returns the vault, or null if the shop
   /// has none. Needs `Shops.Manage`.
   linkShopVault: (shopId: principal) -> (Result_32);
   /// The alerts the caller hasn't muted, newest first, a page at a time: pass a page's `next` as
   /// `after` for older ones. A page can be short, or empty with a `next`, where muted alerts were
   /// skipped. Needs `Alerts.View`.
   listAlerts: (after: opt nat, limit: opt nat) -> (Result_31) query;
   /// Shops shown as artist pages, for the marketplace's Music page (BRE-201), a page at a time in
   /// canister ID order: pass `next` back as `after`. Shops trust_safety hid are left out, so a page
   /// can be short, or empty with a `next`. Empty until core has first copied the hidden shops from
   /// product_index, two minutes after the upgrade that added this (BRE-201).
   listArtistShops: (after: opt principal, limit: opt nat) -> (Page_7) query;
   /// The registered shops whose shop or vault may be a new version's canary. Needs `Upgrades.View`.
   listCanaryShops: () -> (Result_23) query;
   /// Every event after sequence number `after`, oldest first, a page at a time. Needs `History.View`.
   listHistory: (after: opt nat, limit: opt nat) -> (Result_29) query;
   /// Members (principals with at least one role) in principal order. Needs `Team.View`.
   listMembers: (after: opt principal, limit: opt nat) -> (Result_28) query;
   /// The caller's saved addresses after id `after`, oldest first, a page at a time. Anonymous callers
   /// get an empty page.
   listMyAddresses: (after: opt AddressId, limit: opt nat) -> (Page_4) query;
   /// Roles in ID order. Needs `Team.View`.
   listRoles: (after: opt RoleId, limit: opt nat) -> (Result_27) query;
   /// Every wasm version core has upgraded a canister to, with its canary and whether it's approved.
   /// Needs `Upgrades.View`.
   listRollouts: () -> (Result_26) query;
   /// The caller's shop creation quotes, newest first, a page at a time.
   listShopCreationQuotes: (after: opt QuoteId, limit: opt nat) ->
    (Page_2) query;
   /// Every registered shop with its owner, vault, who controls them (`control`, BRE-79), and the
   /// wasm version core last installed on the shop and its vault (null when unknown: shops created
   /// before versions were recorded, shops registered with `registerShop`, and self-managed
   /// shops). A page at a time, by name. Needs `Shops.View`.
   listShopRegistry: (after: opt RegistryCursor, limit: opt nat) ->
    (Result_25) query;
   /// Every published release, newest first: version, SHA-256, size and notes. Public. Call it
   /// as an update (the `icp` default) for a certified answer to check a download against.
   listShopReleases: () -> (vec Release) query;
   /// Shops registered in the marketplace, for browsing, a page at a time in canister ID order (see
   /// `lib/Pagination`: pass `next` back as `after`).
   listShops: (after: opt principal, limit: opt nat) -> (Page) query;
   /// Quotes left `#Creating` or `#Refunding` by a claim or refund that no longer runs (BRE-68).
   /// Release each with `releaseStuckShopCreationQuote`. Needs `ShopCreation.Manage`.
   listStuckShopCreationQuotes: () -> (Result_24) query;
   /// Registered shops whose events core may have missed: the last event subscription failed, or
   /// `checkShopSubscriptions` found the shop had dropped core and couldn't resubscribe or resync its
   /// products (the next check retries the resync). Their products and orders may be missing from the
   /// marketplace. Retry them with `resubscribeShops` or `checkShopSubscriptions`. Needs `Shops.View`.
   listUnsubscribedShops: () -> (Result_23) query;
   /// The versions of a wasm stored in the canister factory, oldest first (version, SHA-256, size,
   /// note, whether it's yanked; not the bytes), to pick one for `upgradeShop` / `upgradeVault`.
   /// Needs `Upgrades.View`.
   listWasms: (name: WasmName) -> (Result_22);
   /// Marks every alert up to number `upTo` read for the caller. Needs `Alerts.View`.
   markAlertsSeen: (upTo: nat) -> (Result_9);
   /// Publishes a shop or vault wasm version stored in the canister factory, with release notes
   /// (at most `MAX_NOTES` characters), so self-managed merchants can install it. Core records the
   /// SHA-256 the factory computed on upload. Publish a version once its rollout is approved; a
   /// yanked version is refused. Needs `Upgrades.Approve`.
   publishRelease: (name: WasmName, version: Version, notes: text) ->
    (Result_20);
   /// Reads the shop's and vault's balances again (after a top-up, say) and returns them as
   /// `getShopCycles` does. Registered users only, and a canister read in the last 5 minutes isn't
   /// read again. Each user may also trigger at most 20 reads an hour (a shop and its
   /// vault are two), else `#RateLimited`, so no one can sweep every shop. No owner
   /// check: the result is public anyway (see `getShopCycles`).
   refreshShopCycles: (shopId: principal) -> (Result_19);
   /// Refunds an unclaimed quote's deposit (less the ledger fee) and closes the quote. Sends it to
   /// `to`, or to the caller's own account (`owner = caller`, no subaccount) when `to` is null:
   /// core never keeps a refund on the caller's behalf (BRE-83).
   refundShopCreationQuote: (quoteId: QuoteId, to: opt Account) ->
    (Result_18);
   /// Registers an existing Shop canister in the marketplace. Used when a user creates a shop via other means (e.g. CLI) and wants to list it in the marketplace, or to re-register after unregistering. The caller must be a registered user and a controller of the canister, which core reads through `canister_status`: core must be a controller or status viewer of it (`icp canister settings update <shop> --add-status-viewer <core>`), and the caller's Breeze sign-in principal must be one of the controllers. The shop's vault is recorded too when the caller controls it and core can read its controllers; otherwise an admin links it with `linkShopVault`.
   registerShop: (req: RegisterShopRequest) -> (RegisterShopResponse);
   /// Unlocks a stuck quote so its owner can claim or refund it again. Returns its new status:
   /// `#Created` if its shop is registered, otherwise `#Paid` if its deposit covers the price, or
   /// `#Pending`. Refuses a quote whose claim or refund is still running. Needs `ShopCreation.Manage`.
   releaseStuckShopCreationQuote: (quoteId: QuoteId) -> (Result_17);
   /// The registered shop that has or had `slug` (any case), with its current slug (BRE-71). An old
   /// slug resolves too: send the visitor to `canonicalSlug`. Null for an unknown slug.
   resolveShopSlug: (slug: text) -> (opt ResolvedShopSlug) query;
   /// Loads core's snapshot of a shop or vault, taken just before its last upgrade: its wasm and
   /// state go back to how they were then, and anything recorded since is lost. For an upgrade
   /// that broke the canister. Needs `Upgrades.Run`.
   restoreSnapshot: (canisterId: principal) -> (Result_16);
   /// Subscribes core to the events (orders included) of `shopIds`, or of every registered shop
   /// when null, then catches up on each one's orders from its order log (BRE-203). Backfills shops
   /// created before core subscribed hosted shops to orders, and retries those in
   /// `listUnsubscribedShops`. Idempotent. Needs `Shops.Manage`: each shop costs core calls.
   resubscribeShops: (shopIds: opt vec principal) -> (Result_15);
   /// Saves a shipping address with a nickname ("Home") for the caller, up to `MAX_ADDRESSES` (10). The
   /// first one saved, or one saved with `makeDefault`, becomes the default. The caller must be a
   /// registered user (`createUser`), never anonymous.
   saveMyAddress: (nickname: text, address: ShippingAddress, makeDefault:
    bool) -> (Result_3);
   /// Allows (`eligible = true`) or stops a registered shop's shop and vault being the canary of a
   /// new version (BRE-147). Mark test shops, not merchants' live ones. Rollouts that already have a
   /// canary keep it. Needs `Upgrades.Run`.
   setCanaryEligible: (shopId: principal, eligible: bool) -> (Result_14);
   /// Makes a wasm version the one new shops or vaults get while none is, with no canary: for a
   /// fresh network (`scripts/setup.sh`) or after every approved version was yanked. Once a
   /// version is current, only `approveRollout` changes it. Needs `Upgrades.Approve`.
   setInitialWasmVersion: (name: WasmName, version: Version) -> (Result_13);
   /// Sets which alert types the caller doesn't want to see; every other type shows. Needs
   /// `Alerts.View`.
   setMutedAlertTypes: (muted: vec AlertType) -> (Result_9);
   /// Makes the caller's saved address `id` the one checkout fills in, or clears the default when
   /// `id` is null. Refuses anonymous callers.
   setMyDefaultAddress: (id: opt AddressId) -> (Result_11);
   /// Turns the fees on or off. Controllers only. Turn them on once the shop version that attaches
   /// cycles is published and self-managed merchants have had time to install it: until then core
   /// refuses their events, so their products and orders stop syncing.
   setShopCallFeesEnforced: (enforced: bool) -> (Result_9);
   /// Sets the hosted shop price in US cents. 0 makes shop creation free. Controllers only.
   setShopCreationPrice: (usdCents: nat) -> (Result_9);
   /// Changes a shop's URL slug. Only the shop's owner (as core's registry records it). Its old slug
   /// keeps leading to it, and no other shop can get it; a shop holds at most 10 slugs.
   setShopSlug: (shopId: principal, slug: text) -> (Result_8);
   /// Hides a shop from, or shows it again in, core's public listings of artists. Only trust_safety
   /// calls it, with each moderator's decision it also sends product_index.
   setShopVisibility: (shopId: principal, visibility: ShopVisibility) ->
    (Result_4);
   /// Starts a shop or vault that an upgrade or restore left stopped (it returned `#StartFailed`).
   /// Needs `Upgrades.Run`.
   startCanister: (canisterId: principal) -> (Result_7);
   /// Starts handing the shop and its vault over to `controller`, a principal the merchant
   /// controls (an `icp identity` or a wallet; not their Breeze sign-in). Core adds it as a
   /// controller of both, next to core, and nothing more happens until `controller` itself calls
   /// `confirmShopHandover`. Shop owner only.
   startShopHandover: (shopId: principal, controller: principal) ->
    (Result_6);
   /// A free slug for a shop called `name`, for the create-shop form to suggest (BRE-71). Not
   /// reserved: `createShopQuote` reserves it.
   suggestShopSlug: (name: text) -> (text) query;
   /// Called by a Shop canister after deleting a product so the marketplace index stays in sync.
   syncDeletedProduct: (event: ProductDeletedEvent) -> ();
   /// Called by a Shop canister after updating its public details so the marketplace home list stays in sync.
   syncShopDetails: (event: ShopDetailsUpdatedEvent) -> ();
   /// Replaces a shop's slice of the marketplace product index with what the shop has now: core
   /// reads the shop's products a page at a time, sends each page to product_index, then removes the
   /// products the shop no longer has (BRE-97). Needs `Shops.Manage`: a sync costs core cycles for
   /// each page (up to `MAX_SYNC_PAGES`), so a shop calling it on itself could repeat it for free (BRE-118).
   syncShopProducts: (shopId: principal) -> (Result_5);
   /// Called by a Shop canister after updating a product so the marketplace index stays in sync.
   syncUpdatedProduct: (event: ProductUpdatedEvent) -> ();
   /// Upserts a marketplace-wide order index entry. Called by a registered shop canister
   /// when an order is created or its status changes. A shop core doesn't host must attach
   /// `ShopCallFees.EVENT_CYCLES` once enforced (BRE-116). A notification that shows core missed
   /// some of the shop's order log starts a short catch-up (BRE-203; rate-limited per shop).
   trackOrder: (req: TrackOrderRequest) -> ();
   /// Needs `Team.AssignRoles` and every permission in the role.
   unassignRole: ("principal": principal, id: RoleId) -> (Result_2);
   /// Unregisters a shop canister from the marketplace: the shop's owner (as core's registry records
   /// it) or an admin. Idempotent for an admin; BRE-119.
   unregisterShop: (canisterId: principal) -> (Result_4);
   /// Undoes `yankWasm`. It doesn't make the version current again. Needs `Upgrades.Approve`.
   unyankWasm: (name: WasmName, version: Version) -> (Result);
   /// Replaces the nickname and address of the caller's saved address `id`. Registered users only.
   updateMyAddress: (id: AddressId, nickname: text, address:
    ShippingAddress) -> (Result_3);
   /// Needs `Team.EditRoles` and every permission in the role before and after.
   updateRole: (id: RoleId, name: text, permissions: vec PermissionId) ->
    (Result_2);
   /// Upgrades a registered shop to a wasm version stored in the canister factory. The first shop
   /// upgraded to a version is its canary, and must be canary-eligible (`setCanaryEligible`); others
   /// wait for `approveRollout`. Needs `Upgrades.Run`.
   upgradeShop: (canisterId: principal, version: Version, args:
    ShopInitArgs) -> (Result_1);
   /// Upgrades a vault core recorded for a shop to a wasm version stored in the canister factory.
   /// The first vault upgraded to a version is its canary, and its shop must be canary-eligible
   /// (`setCanaryEligible`); others wait for `approveRollout`. Needs `Upgrades.Run`.
   upgradeVault: (canisterId: principal, version: Version) -> (Result_1);
   /// Withdraws a wasm version in the canister factory, so nothing can install it (new shops,
   /// upgrades, publishing), and if new shops were getting it, moves them back to the last approved
   /// version that isn't yanked. Canisters already running it keep it: upgrade them off it. Needs `Upgrades.Approve`.
   yankWasm: (name: WasmName, version: Version) -> (Result);
 };
type ControlStatus = 
 variant {
   HandoverPending: Pending;
   Managed;
   SelfManaged: SelfManaged;
 };
type CheckShopSlugError = 
 variant {
   InvalidSlug: text;
   SlugTaken;
 };
type CanisterRunway = 
 record {
   canisterId: principal;
   kind: ShopCanisterKind;
   runway: opt Runway;
   selfManaged: bool;
 };
type CanisterKind = 
 variant {
   canisterFactory;
   core;
   frontend;
   productIndex;
 };
type CanisterCycles = 
 record {
   canisterId: principal;
   kind: CanisterKind;
   status: Result_43;
 };
type Balances = 
 record {
   accounts: vec AccountBalance;
   ckusdc: nat;
   icp: nat;
 };
type AssetClass = 
 variant {
   Cryptocurrency;
   FiatCurrency;
 };
type Asset = 
 record {
   class: AssetClass;
   symbol: text;
 };
type ArtistShopInfo = 
 record {
   canisterId: principal;
   logoUrl: opt text;
   name: text;
   slug: text;
 };
type ApproveError = 
 variant {
   CanaryNotUpgraded: record {canary: principal;};
   NotFound;
   Unauthorized;
   Yanked;
 };
type AlertType = 
 variant {
   shopCreated;
   shopCreationFailed;
   shopRegistered;
   userRegistered;
 };
type AlertSummary = 
 record {
   latest: opt nat;
   unread: nat;
 };
type AlertSettings = 
 record {
   lastSeen: opt nat;
   muted: vec AlertType;
 };
type AlertKind = 
 variant {
   shopCreated: record {
                  owner: principal;
                  shop: principal;
                };
   shopCreationFailed: record {
                         error: text;
                         owner: principal;
                         quoteId: nat;
                       };
   shopRegistered: record {
                     owner: principal;
                     shop: principal;
                   };
   userRegistered: record {user: principal;};
 };
type Alert = 
 record {
   at: int;
   kind: AlertKind;
   seq: nat;
 };
type AdminShopInfo = 
 record {
   canisterId: principal;
   control: ControlStatus;
   name: text;
   owner: principal;
   registrationDate: Time;
   shopVersion: opt InstalledWasm;
   slug: text;
   vaultId: opt principal;
   vaultVersion: opt InstalledWasm;
 };
type AddressId = nat;
type AddressError = 
 variant {
   InvalidAddress: text;
   InvalidNickname: text;
   LimitReached: nat;
   NotFound;
   NotRegistered;
   Unauthenticated;
 };
type Address = 
 record {
   city: text;
   country: text;
   line1: text;
   line2: opt text;
   postalCode: text;
   region: text;
 };
type AddManagedShopResponse = 
 variant {
   err: AddManagedShopError;
   ok;
 };
type AddManagedShopError = 
 variant {
   AlreadyAdded: text;
   NotFound: text;
   Unauthorized: text;
 };
type AccountKind = 
 variant {
   main;
   shopCreationDeposit: nat;
 };
type AccountBalance = 
 record {
   ckusdc: nat;
   icp: nat;
   kind: AccountKind;
   subaccount: opt blob;
 };
type Account = 
 record {
   owner: principal;
   subaccount: opt blob;
 };
service : () -> Core
