   shopRegistered: record {owner: principal;};
   shopSlugChanged: record {slug: text;};
   shopUnregistered;
   snapshotRestored: record {
                       canister: principal;
                       outcome: Outcome;
                     };
   stuckQuoteReleased: record {quoteId: nat;};
   upgraded:
    record {
      canister: principal;
      name: WasmName;
      outcome: Outcome;
      version: Version;
    };
   vaultLinked: record {vault: opt principal;};
   wasmUnyanked: record {
                   name: WasmName;
                   version: Version;
                 };
   wasmYanked: record {
                 name: WasmName;
                 version: Version;
               };
 };
